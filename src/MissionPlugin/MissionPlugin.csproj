<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0: a plugin owns parsing and nothing else, so it must not be able to reach a
       WinRT type. The Windows TFM stops at the engine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MissionPlugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ocrx.Contracts" Version="2.0.0" />
    <PackageReference Include="Ocrx.Sdk" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MissionPlugin.Tests" />
  </ItemGroup>

</Project>
