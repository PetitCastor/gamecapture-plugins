<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0: a plugin owns parsing and nothing else, so it must not be able to reach a
       WinRT type. The Windows TFM stops at the engine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MissionPlugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GameCapture.Contracts" Version="1.*" />
    <PackageReference Include="GameCapture.Sdk" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MissionPlugin.Tests" />
  </ItemGroup>

</Project>
