<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0: a plugin owns parsing and nothing else, so it must not be able to reach a
       WinRT type. The Windows TFM stops at the engine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RefineryPlugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GameCapture.Contracts" Version="1.*" />
    <PackageReference Include="GameCapture.Sdk" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Own-test grant only, same as MissionPlugin: this survives the repo split because the test
         project ships beside its plugin. The former GameCapture.Engine.Tests grant is gone — the
         replay-parity tests now drive this plugin through the public GameCapturePluginHost surface
         (TASK-11), so they no longer need its internals. -->
    <InternalsVisibleTo Include="RefineryPlugin.Tests" />
  </ItemGroup>

</Project>
