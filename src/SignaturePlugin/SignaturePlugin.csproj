<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0: a plugin parses text; it never touches the capture stack, so the Windows
       TFM the engine needs must not appear here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SignaturePlugin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GameCapture.Sdk" Version="1.*" />
    <PackageReference Include="GameCapture.Contracts" Version="1.*" />
    <PackageReference Include="GameCapture.Sdk.Overlay" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.json" />
    <EmbeddedResource Include="Resources\signature-table.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Own-test grant only, same as MissionPlugin/RefineryPlugin: lets SignaturePlugin.Tests exercise
         SignatureAbsenceDebouncer directly without making it a public type. -->
    <InternalsVisibleTo Include="SignaturePlugin.Tests" />
  </ItemGroup>

</Project>
