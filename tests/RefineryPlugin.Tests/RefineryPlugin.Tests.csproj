<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0, like the plugin under test: if this project ever needed a Windows TFM to
       compile, the plugin would have grown a dependency on the capture stack. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RefineryPlugin\RefineryPlugin.csproj" />
    <PackageReference Include="Ocrx.Sdk" Version="2.0.0" />
    <!-- Ticks are built through Ocrx.Sdk.Testing's public TickDataBuilder now, not the SDK's
         internal TickData.From (the InternalsVisibleTo grant that died with TASK-11). Ocrx.Contracts
         still comes in directly for RoiRect/RectF geometry in the fabricated OCR word boxes. -->
    <PackageReference Include="Ocrx.Contracts" Version="2.0.0" />
    <PackageReference Include="Ocrx.Sdk.Testing" Version="2.0.0" />
  </ItemGroup>

  <!-- The replay corpora this plugin's parity tests drive: the monolith's two, plus
       refinery-full-list (a COMPLETED panel filled to its 10-row capacity, which neither monolith
       corpus exercised - refinery-confirm tops out at four rows and refinery-ice-rename at one, so
       both stayed green while Rois.YieldList covered only five). Scoped one corpus per entry
       (not a `corpus\**` catch-all) so another plugin's corpus landing under tests\fixtures\corpus
       doesn't get copied into every other plugin's test output. Copied next to the test assembly
       so ReplayParityTests's relative paths resolve at run time. -->
  <ItemGroup>
    <None Include="..\fixtures\corpus\refinery-confirm\**\*.png" Link="Fixtures\Replay\refinery-confirm\%(RecursiveDir)%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\corpus\refinery-ice-rename\**\*.png" Link="Fixtures\Replay\refinery-ice-rename\%(RecursiveDir)%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\corpus\refinery-full-list\**\*.png" Link="Fixtures\Replay\refinery-full-list\%(RecursiveDir)%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
