<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0, like the plugin under test: if this project ever needed a Windows TFM to
       compile, the plugin would have grown a dependency on the capture stack. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SignaturePlugin\SignaturePlugin.csproj" />
    <!-- TickDataBuilder, FakePluginServices, ReplayHarness, EngineLocator. Brings GameCapture.Sdk
         and GameCapture.Contracts transitively. -->
    <PackageReference Include="GameCapture.Sdk.Testing" Version="1.1.32" />
  </ItemGroup>

  <!-- Scan-mode corpus for ReplayParityTests.ScanSignature_corpus_matches_manifest_records. Kept
       under tests\fixtures\corpus so it mirrors the existing Refinery parity layout, but linked
       beside the test assembly where ReplayCorpus.Resolve("Fixtures/Replay/scan-signature")
       expects it. -->
  <ItemGroup>
    <None Include="..\fixtures\corpus\scan-signature\**\*.png" Link="Fixtures\Replay\scan-signature\%(RecursiveDir)%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\corpus\scan-signature\**\manifest.json" Link="Fixtures\Replay\scan-signature\%(RecursiveDir)%(FileName)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
