<Project>

  <!-- Minimal on purpose (TASK-23, per TASK-21 rehearsal note 2): this repo consumes Ocrx as
       packages, it doesn't publish any of its own, so it skips the engine repo's MinVer/SourceLink/
       IsPackable machinery entirely. Without at least Nullable+ImplicitUsings set repo-wide, both
       plugin projects fail to build (60 CS0246s — Task, CancellationToken, IReadOnlyList<>, etc. all
       "not found") because neither .csproj sets these itself. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Same audit-code exemption as the engine repo: a newly published advisory against a
         transitive dependency must not turn every build here red with no code change of our own. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
